{
  "name": "fpt-campus-3d",
  "private": true,
  "version": "0.1.0",
  "type": "module",
  "description": "Diorama 3D khuôn viên FPT University Đà Nẵng phục vụ tuyển sinh",
  "engines": {
    "node": ">=22.12"
  },
  "scripts": {
    "data": "node tools/xlsx-to-json.mjs",
    "data:template": "node tools/create-xlsx-template.mjs",
    "model": "node tools/build-model.mjs",
    "prepare-assets": "node tools/copy-draco.mjs && node tools/xlsx-to-json.mjs",
    "predev": "npm run prepare-assets",
    "dev": "vite --host",
    "prebuild": "npm run prepare-assets",
    "build": "vite build",
    "preview": "vite preview --host"
  },
  "dependencies": {
    "three": "0.186.1"
  },
  "devDependencies": {
    "exceljs": "4.4.0",
    "vite": "8.3.5"
  }
}
